<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="44dp" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
    <ImageView android:id="@+id/mark" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/w_todo" android:contentDescription="Holat" />
    <TextView android:id="@+id/time" android:layout_width="46dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#3F4B47" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="#14201D" android:textSize="14sp" />
    <TextView android:id="@+id/who" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/w_tag" android:paddingStart="6dp" android:paddingTop="2dp" android:paddingEnd="6dp" android:paddingBottom="2dp" android:textColor="#6B4A00" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
