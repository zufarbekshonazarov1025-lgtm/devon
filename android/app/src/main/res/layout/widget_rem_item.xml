<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/w_tile_amber" android:padding="6dp" android:src="@drawable/w_bell" android:contentDescription="Eslatma" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#14201D" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3F4B47" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/who" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/w_tag" android:paddingStart="6dp" android:paddingTop="2dp" android:paddingEnd="6dp" android:paddingBottom="2dp" android:textColor="#6B4A00" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
