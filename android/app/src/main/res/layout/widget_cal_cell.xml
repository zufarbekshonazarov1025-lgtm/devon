<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#14201D" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:letterSpacing="0.1" android:textSize="6sp" />
</LinearLayout>
